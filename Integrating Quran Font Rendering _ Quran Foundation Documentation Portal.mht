ass="token plain">import 'dart:convert';</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">class QuranVerse {</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">  final String verseKey;</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">  final List&lt;QuranWord&gt; words;</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">  QuranVerse({required this.verseKey, required this.words});</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">  factory QuranVerse.fromJson(Map&lt;String, dynamic&gt; json) {</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">    return QuranVerse(</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">      verseKey: json['verse_key'],</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">      words: (json['words'] as List)</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">          .map((w) =&gt; QuranWord.fromJson(w))</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">          .toList(),</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">    );</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class