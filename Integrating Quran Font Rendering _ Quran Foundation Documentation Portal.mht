an><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                      fontFamily: 'UthmanicHafs', // Add to pubspec.yaml</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                      fontSize: 24,</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                      height: 2,</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                      color: Colors.black,</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                    ),</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                  ),</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                  TextSpan(</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                    text: ' (${verse.verseKey})',</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                    style: const TextStyle(</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                      fontSize: 12,</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                      color: Colors.grey,</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                    ),</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                  ),</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">                ],</span><br></span><span class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">              ),</span